# ==============================================================================
# OBSERVABILITY AGENTS CONFIGURATION (WORKER NODES: OCI / ORANGEPI / ETC.)
# ==============================================================================

# --- 1. Host System User & Standard Data Directory ---
# Host system user on this worker node (e.g. ubuntu on OCI, pi on OrangePi)
SYSTEM_USER=ubuntu

# Master Data Root for persistent state
DATA_DIR=/home/${SYSTEM_USER}/DATA/var/observability

# Node Identity (Must match the NODE_NAME from your homelab-nodes setup)
NODE_NAME=oci01-flex

# Docker Node ID (Must match the DOCKER_NODE_ID generated in homelab-nodes/.env)
# This prevents naming collisions on the Swarm network.
DOCKER_NODE_ID=worker-abc123xyz

# --- 2. Beszel Telemetry Agent ---
# Public key copied from Beszel Hub (https://metrics.example.com -> Add System)
BESZEL_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...

# Dual-Mode Push Transport (Optional Token & Hub URL from Beszel Hub modal)
BESZEL_TOKEN=
BESZEL_HUB_URL=https://metrics.example.com



