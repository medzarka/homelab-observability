# ==============================================================================
# OBSERVABILITY & HOMELAB PORTAL CONFIGURATION (MANAGER NODE: VM1)
# ==============================================================================

# --- 1. Host System User & Standard Data Directory ---
# The user on the host VM (e.g., mgrsys on VPS/Swarm, ubuntu on OCI)
SYSTEM_USER=mgrsys

# Master Data Root for persistent state
DATA_DIR=/home/${SYSTEM_USER}/DATA

# --- 2. Timezone & Domain Routing ---
TZ=UTC
ROOT_DOMAIN=example.com
SHARED_NETWORK=shared_net

# --- 3. Beszel Telemetry Hub & Agent ---
# Public key generated in Beszel Hub (https://metrics.example.com -> Add System)
BESZEL_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
# Optional Token and Hub URL for dual-mode push transport
BESZEL_TOKEN=
BESZEL_HUB_URL=https://metrics.bluewave.work

# --- 4. Dozzle Multi-Node Remote Agents ---
# Comma-separated list of remote worker nodes listening on Tailscale port 7007
# Example: 100.x.y.2:7007 (Node 1), 100.x.y.3:7007 (Node 2)
DOZZLE_REMOTE_AGENT=100.x.y.2:7007,100.x.y.3:7007
