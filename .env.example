# ==============================================================================
# OBSERVABILITY & HOMELAB PORTAL ENVIRONMENT VARIABLES
# ==============================================================================

# --- 1. Host System User & Standard Data Directory ---
# The user on the host VM (e.g., mgrsys on VPS/Swarm, ubuntu on OCI)
SYSTEM_USER=mgrsys

# Master Data Root for persistent state (Follows template: /home/${SYSTEM_USER}/DATA/<stack-name>/data/<container-name>)
DATA_DIR=/home/${SYSTEM_USER}/DATA

# --- 2. Timezone & Host Routing ---
TZ=UTC
HOMEPAGE_ALLOWED_HOSTS=homelab.bluewave.work,hub.bluewave.work,127.0.0.1,localhost
SHARED_NETWORK=shared_net

# --- 3. Beszel Telemetry Hub ---
# Public key generated in Beszel Hub (https://metrics.bluewave.work -> Add System)
BESZEL_PUBLIC_KEY=

# --- 4. Dozzle Multi-Node Remote Agents ---
# Comma-separated list of remote worker nodes listening on Tailscale port 7007
DOZZLE_REMOTE_AGENT=100.83.191.68:7007,100.71.154.78:7007
