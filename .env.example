# ==============================================================================
# OBSERVABILITY & HOMELAB PORTAL CONFIGURATION (MANAGER NODE: zap-vps)
# ==============================================================================

# --- 1. Host System User & Standard Data Directory ---
SYSTEM_USER=mgrsys
DATA_DIR=/home/${SYSTEM_USER}/DATA

# --- 2. Timezone & Domain Routing ---
TZ=UTC
ROOT_DOMAIN=example.com
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net

# --- 3. Beszel Telemetry Hub & Local Agent ---
# Step 1: Deploy stack with BESZEL_PUBLIC_KEY empty.
# Step 2: Open https://metrics.example.com -> Add System -> Copy Public Key.
# Step 3: Paste public key below and restart beszel-agent:
BESZEL_PUBLIC_KEY=
BESZEL_TOKEN=
BESZEL_HUB_URL=

# --- 4. Dozzle Multi-Node Remote Agents ---
# Comma-separated list of remote worker nodes streaming logs on Swarm overlay network port 7007
# Example: dozzle_agent_zap-srv:7007,dozzle_agent_oci01-flex:7007
DOZZLE_REMOTE_AGENT=
