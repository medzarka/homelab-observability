# ==============================================================================
# OBSERVABILITY & HOMELAB PORTAL ENVIRONMENT VARIABLES
# ==============================================================================

# Data storage root on the host (Default: /srv/data/observability or /home/mgrsys/DATA/observability)
OBSERVABILITY_HOME=/home/mgrsys/DATA/observability

# Timezone for log timestamps and dashboard widgets
TZ=UTC

# Beszel Public Key generated upon first login in the Beszel Hub (https://metrics.bluewave.work)
BESZEL_PUBLIC_KEY=

# Dozzle Remote Agents on VM2 and VM3 across Tailscale mesh (comma separated)
DOZZLE_REMOTE_AGENT=100.83.191.68:7007,100.71.154.78:7007
